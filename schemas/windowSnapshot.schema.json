{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "window_snapshot",
  "type": "object",
  "required": ["event_type", "timestamp", "monitors", "windows"],
  "properties": {
    "event_type": {
      "type": "string",
      "const": "window_snapshot"
    },
    "timestamp": {
      "type": "string"
    },
    "monitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["monitor_id", "width", "height"],
        "properties": {
          "monitor_id": {
            "type": ["string", "number"]
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "app_name",
          "app_id",
          "monitor_id",
          "size_class",
          "is_minimized"
        ],
        "properties": {
          "app_name": {
            "type": "string"
          },
          "app_id": {
            "type": "string"
          },
          "monitor_id": {
            "type": ["string", "number"]
          },
          "size_class": {
            "type": "string",
            "enum": ["full", "large", "half", "medium", "quarter", "small"]
          },
          "is_minimized": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}